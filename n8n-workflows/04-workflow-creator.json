    {
      "id": "d4e5f6a7-0004-0004-0004-000000000003",
      "name": "Construir Prompt para LLM",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300],
      "parameters": {
        "jsCode": "const description = $input.first().json.description;\nconst workflow_name = $input.first().json.workflow_name;\n\nconst systemPrompt = `Sos un experto en n8n. Generás workflows JSON válidos e importables.\n\nREGLAS OBLIGATORIAS:\n1. Responder SOLO con JSON válido, sin texto adicional, sin markdown, sin bloques de código\n2. El JSON debe tener exactamente: name, nodes (array), connections (object), active, settings\n3. Cada nodo necesita: id (UUID único), name, type, typeVersion, position ([x,y]), parameters\n4. Las connections mapean nombre-de-nodo → { main: [[{ node, type, index }]] }\n5. Tipos de nodos disponibles:\n   - n8n-nodes-base.webhook (trigger HTTP)\n   - n8n-nodes-base.httpRequest (llamadas HTTP)\n   - n8n-nodes-base.code (JavaScript)\n   - n8n-nodes-base.set (setear variables)\n   - n8n-nodes-base.if (condiciones)\n   - n8n-nodes-base.switch (múltiples rutas)\n   - n8n-nodes-base.respondToWebhook (responder webhook)\n   - n8n-nodes-base.schedule (trigger por tiempo)\n   - n8n-nodes-base.postgres (base de datos)\n   - n8n-nodes-base.gmail (email)\n\nEJEMPLO de estructura mínima:\n{\n  \"name\": \"Mi Workflow\",\n  \"active\": false,\n  \"settings\": { \"executionOrder\": \"v1\" },\n  \"nodes\": [\n    {\n      \"id\": \"aaa-bbb-ccc-ddd\",\n      \"name\": \"Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [0, 300],\n      \"parameters\": { \"path\": \"mi-path\", \"httpMethod\": \"POST\", \"responseMode\": \"onReceived\" }\n    }\n  ],\n  \"connections\": {}\n}`;\n\nconst userPrompt = `Creá un workflow n8n llamado \"${workflow_name}\" que haga lo siguiente:\\n\\n${description}\\n\\nRecordá: SOLO JSON válido como respuesta.`;\n\nreturn [{ json: {\n  system_prompt: systemPrompt,\n  user_prompt: userPrompt,\n  workflow_name: $input.first().json.workflow_name,\n  activate: $input.first().json.activate,\n  description: $input.first().json.description\n}}];"
      }
    },
    {
      "id": "d4e5f6a7-0004-0004-0004-000000000004",
      "name": "LLM Genera Workflow JSON",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 300],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:11434/api/chat",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'gemma3:12b',\n  stream: false,\n  options: { temperature: 0.1, num_ctx: 8192 },\n  messages: [\n    { role: 'system', content: $json.system_prompt },\n    { role: 'user', content: $json.user_prompt }\n  ]\n}) }}",
        "options": {
          "timeout": 120000,
          "response": {
            "response": { "responseFormat": "json" }
          }
        }
      }
    },
    {
      "id": "d4e5f6a7-0004-0004-0004-000000000005",
      "name": "Parsear y Validar JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 300],
      "parameters": {
        "jsCode": "const llmResponse = $input.first().json;\nconst rawContent = llmResponse.message?.content || llmResponse.choices?.[0]?.message?.content || '';\n\n// Limpiar markdown si el modelo lo incluyó igual\nlet cleaned = rawContent.trim();\ncleaned = cleaned.replace(/^```json\\s*/i, '').replace(/^```\\s*/i, '');\ncleaned = cleaned.replace(/\\s*```$/i, '');\n\n// Intentar parsear\nlet workflowJson;\ntry {\n  workflowJson = JSON.parse(cleaned);\n} catch(e) {\n  // Intentar extraer JSON del texto\n  const match = cleaned.match(/\\{[\\s\\S]*\\}/);\n  if (match) {\n    try {\n      workflowJson = JSON.parse(match[0]);\n    } catch(e2) {\n      return [{ json: {\n        valid: false,\n        error: 'No se pudo parsear el JSON: ' + e2.message,\n        raw_content: rawContent.slice(0, 500)\n      }}];\n    }\n  } else {\n    return [{ json: {\n      valid: false,\n      error: 'No se encontró JSON en la respuesta',\n      raw_content: rawContent.slice(0, 500)\n    }}];\n  }\n}\n\n// Validar estructura mínima\nconst required = ['name', 'nodes', 'connections'];\nconst missing = required.filter(k => !workflowJson[k]);\n\nif (missing.length > 0) {\n  return [{ json: {\n    valid: false,\n    error: 'Faltan campos obligatorios: ' + missing.join(', '),\n    raw_content: rawContent.slice(0, 500)\n  }}];\n}\n\nif (!Array.isArray(workflowJson.nodes) || workflowJson.nodes.length === 0) {\n  return [{ json: {\n    valid: false,\n    error: 'El array de nodos está vacío',\n    raw_content: rawContent.slice(0, 500)\n  }}];\n}\n\n// Asegurar settings mínimos\nworkflowJson.settings = workflowJson.settings || { executionOrder: 'v1' };\nworkflowJson.active = false; // siempre inactivo al crear\n\nreturn [{ json: {\n  valid: true,\n  workflow: workflowJson,\n  node_count: workflowJson.nodes.length\n}}];"
      }
    },
    {
      "id": "d4e5f6a7-0004-0004-0004-000000000006",
      "name": "¿JSON Válido?",
